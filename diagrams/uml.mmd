classDiagram
    class Task {
        +str description
        +str time
        +str frequency
        +bool completed
        +mark_complete()
    }
    class Pet {
        +str name
        +str species
        +List[Task] tasks
        +add_task(task: Task)
        +get_task_count() int
    }
    class Owner {
        +str name
        +List[Pet] pets
        +add_pet(pet: Pet)
        +get_all_tasks() List[Tuple[str, Task]]
    }
    class Scheduler {
        +Owner owner
        +get_all_tasks() List[Tuple[str, Task]]
        +sort_by_time() List[Tuple[str, Task]]
        +filter_tasks(completed, pet_name) List[Tuple[str, Task]]
        +detect_conflicts() List[str]
        +complete_task_with_recurrence(pet_name, task_description)
    }
    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : manages
